{
  "name": "filamentinventory",
  "private": true,
  "version": "10.2.0",
  "description": "Local-first private filament inventory PWA with streamlined mobile UX, smart intake, QR-first physical spool workflows, contextual and bulk spool operations, Printer/AMS command center, secure sync, labels, and per-user customization.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "node scripts/validate.mjs && node scripts/css-audit.mjs",
    "lint:css": "node scripts/css-audit.mjs",
    "test": "node --experimental-strip-types --test",
    "build": "node scripts/build.mjs",
    "test:e2e:deps": "npm install --no-save --package-lock=false --ignore-scripts --no-audit --no-fund @playwright/test@1.62.1",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "ci": "npm run lint && npm test && npm run build",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "11.0.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.0",
    "@types/qrcode": "1.5.6"
  }
}
