  if(g_audioSettingsView){drawAudioSettings(full);return;}if(g_networkSettingsView){drawNetworkEssentials(full);return;}if(g_ui12SystemView==1){drawUi12PortalAccess();return;}
  (void)full;const int16_t W=tft.width();tft.fillScreen(C10_BG);const bool wifi=WiFi.status()==WL_CONNECTED,touchOk=hubTouchHealthy(),recoveryOk=recoveryWebReady();const bool overall=wifi&&touchOk&&recoveryOk;drawHeader("System",overall?"Healthy":"Check",3);uiBottomNav(3,nullptr);
  if(hubLandscape()) {
    HubRect health=hr(8,44,220,124),network=hubSystemNetworkCardRect(),device=hr(236,132,W-244,78);hubV1125Card(health,overall?C10_GREEN:C10_ORANGE,true);hubV1125Card(network,wifi?C10_GREEN:C10_ORANGE,false);hubV1125Card(device,C10_SEPARATOR,false);
    uiDrawFit("Device Health",health.x+14,health.y+12,health.w-28,FONT_SMALL,TL_DATUM,C10_MUTED,C10_SURFACE_2);uiDrawFit(overall?"Healthy":"Needs Attention",health.x+14,health.y+38,health.w-28,FONT_LARGE,TL_DATUM,overall?C10_GREEN:C10_ORANGE,C10_SURFACE_2);uiDrawFit(touchOk?"Touch: OK":"Touch: Check",health.x+14,health.y+86,90,FONT_SMALL,TL_DATUM,touchOk?C10_TEXT:C10_ORANGE,C10_SURFACE_2);uiDrawFit(recoveryOk?"Recovery: Ready":"Recovery: Starting",health.x+112,health.y+86,health.w-126,FONT_SMALL,TL_DATUM,recoveryOk?C10_TEXT:C10_ORANGE,C10_SURFACE_2);
    uiDrawFit("Network",network.x+14,network.y+12,network.w-28,FONT_SMALL,TL_DATUM,C10_MUTED,C10_SURFACE);uiDrawFit(wifi?"Connected":"Offline",network.x+14,network.y+40,network.w-28,FONT_BODY,TL_DATUM,wifi?C10_GREEN:C10_ORANGE,C10_SURFACE);uiDrawFit("Network settings are available from Settings",network.x+14,network.y+66,network.w-28,FONT_SMALL,BL_DATUM,C10_MUTED,C10_SURFACE);
    char ver[32];snprintf(ver,sizeof(ver),"Workshop OS %s",SMART_HOME_VERSION);uiDrawFit("About",device.x+14,device.y+12,device.w-28,FONT_SMALL,TL_DATUM,C10_MUTED,C10_SURFACE);uiDrawFit(ver,device.x+14,device.y+40,device.w-28,FONT_BODY,TL_DATUM,C10_TEXT,C10_SURFACE);
  } else {
    HubRect health=hr(8,52,W-16,124),network=hr(8,184,W-16,96),device=hr(8,288,W-16,66);hubV1125Card(health,overall?C10_GREEN:C10_ORANGE,true);hubV1125Card(network,wifi?C10_GREEN:C10_ORANGE,false);hubV1125Card(device,C10_SEPARATOR,false);uiDrawFit(overall?"Healthy":"Needs Attention",health.x+14,health.y+42,health.w-28,FONT_LARGE,TL_DATUM,overall?C10_GREEN:C10_ORANGE,C10_SURFACE_2);uiDrawFit(wifi?"Network connected":"Network offline",network.x+14,network.y+36,network.w-28,FONT_BODY,TL_DATUM,wifi?C10_GREEN:C10_ORANGE,C10_SURFACE);char ver[32];snprintf(ver,sizeof(ver),"Workshop OS %s",SMART_HOME_VERSION);uiDrawFit(ver,device.x+14,device.y+30,device.w-28,FONT_BODY,TL_DATUM,C10_TEXT,C10_SURFACE);
  }
  hubV1125Action(hubUi12SystemBackRect(),"Back",C10_ACCENT,true,false);hubV1125Action(hubUi12SystemPortalRect(),"Local Portal",C10_ACCENT,true,false);hubMarkFrameDirty();g_dirty=false;
}
