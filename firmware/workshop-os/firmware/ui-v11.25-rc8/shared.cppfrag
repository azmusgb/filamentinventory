@@FINGERPRINT_HELPERS@@
static const char* hubV1125UiFingerprint(uint8_t page) {
  switch(page) {
    case 0: return "UI8-H";
    case 1: return "UI8-P";
    case 2: return "UI8-W";
    case 3: return "UI8-M";
    case 4: return "UI8-S";
    default: return "UI8";
  }
}
@@END_FINGERPRINT_HELPERS@@
@@HEADER@@
static void drawHeader(const char* title, const char* right, uint8_t page) {
  const int16_t W=tft.width(),HH=hubHeaderH();
  const bool online=WiFi.status()==WL_CONNECTED;
  tft.fillRect(0,0,W,HH,W25_BG);
  tft.fillRoundRect(8,6,24,24,7,W25_ACCENT);
  uiDrawFit("W",20,18,16,FONT_BODY,MC_DATUM,W25_BG,W25_ACCENT);
  uiDrawFit(title?title:"HOME",40,7,hubLandscape()?252:168,FONT_BODY,TL_DATUM,W25_TEXT,W25_BG);
  const char* state=right&&right[0]?right:(online?"ONLINE":"OFFLINE");
  const uint16_t c=right&&right[0]?W25_INFO:(online?W25_SUCCESS:W25_DANGER);
  const int16_t pw=hubLandscape()?86:76;
  tft.fillRoundRect(W-pw-8,7,pw,22,11,W25_NAV);
  tft.fillCircle(W-pw+1,18,3,c);
  uiDrawFit(state,W-14,18,pw-22,FONT_SMALL,MR_DATUM,c,W25_NAV);
  (void)hubV1125UiFingerprint(page);
  tft.drawFastHLine(8,HH-1,W-16,W25_LINE);
}
@@END_HEADER@@
@@BOTTOM_NAV@@
static void uiBottomNav(uint8_t active, const char* nextPage) {
  (void)nextPage;
  const int16_t y=tft.height()-hubNavH(),W=tft.width();
  static const char* labels[4]={"HOME","PRINTER","WORKSHOP","MORE"};
  tft.fillRect(0,y,W,hubNavH(),W25_NAV);
  tft.drawFastHLine(0,y,W,W25_LINE);
  for(uint8_t i=0;i<4;i++){
    HubRect r=hubNavRect(i);const bool selected=i==active;
    const uint16_t bg=selected?W25_ACCENT:W25_NAV;
    if(selected){
      tft.fillRoundRect(r.x+5,r.y+5,r.w-10,r.h-10,10,bg);
      tft.drawRoundRect(r.x+5,r.y+5,r.w-10,r.h-10,10,W25_ACCENT);
    }
    uiDrawFit(labels[i],r.x+r.w/2,r.y+r.h/2+1,r.w-16,FONT_BODY,MC_DATUM,selected?W25_BG:W25_MUTED,bg);
  }
}
@@END_BOTTOM_NAV@@
