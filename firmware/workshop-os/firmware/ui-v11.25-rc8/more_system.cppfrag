@@MORE@@
static void drawMore(bool full) {
  if(g_displayExperienceView){drawDisplayExperience(full);return;}
  if(g_toolsView){drawTools(full);return;}
  (void)full;const int16_t W=tft.width();tft.fillScreen(W25_BG);drawHeader("MORE",nullptr,3);uiBottomNav(3,nullptr);
  const char* titles[4]={"CUSTOMIZE","SYSTEM","DISPLAY","TOOLS"};
  const char* subs[4]={"Choose Home cards","Network and device","Screen and standby","Timers and utilities"};
  for(uint8_t i=0;i<4;i++){
    HubRect r=hubV1125MoreRect(i);hubV1125Card(r,i==1?W25_INFO:W25_LINE,false);
    tft.fillRoundRect(r.x+12,r.y+12,30,30,9,W25_SURFACE_2);tft.drawRoundRect(r.x+12,r.y+12,30,30,9,i==1?W25_INFO:W25_LINE);uiMoreIcon(hr(r.x+7,r.y+7,40,40),i,i==1?W25_INFO:W25_ACCENT);
    if(hubLandscape()){uiDrawFit(titles[i],r.x+54,r.y+15,r.w-84,FONT_BODY,TL_DATUM,W25_TEXT,W25_SURFACE);uiDrawFit(subs[i],r.x+54,r.y+44,r.w-84,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);const int16_t cx=r.x+r.w-18,cy=r.y+r.h/2;tft.drawLine(cx-4,cy-5,cx+1,cy,W25_MUTED);tft.drawLine(cx+1,cy,cx-4,cy+5,W25_MUTED);}
    else{uiDrawFit(titles[i],r.x+12,r.y+54,r.w-24,FONT_BODY,TL_DATUM,W25_TEXT,W25_SURFACE);uiDrawFit(subs[i],r.x+12,r.y+84,r.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);}
  }
  hubMarkFrameDirty();g_dirty=false;
}
@@END_MORE@@
@@SYSTEM@@
static void drawSystem(bool full) {
  if(g_audioSettingsView){drawAudioSettings(full);return;}
  if(g_networkSettingsView){drawNetworkEssentials(full);return;}
  (void)full;const int16_t W=tft.width();tft.fillScreen(W25_BG);const bool wifi=WiFi.status()==WL_CONNECTED,touchOk=hubTouchHealthy(),serviceOk=recoveryWebReady();const bool overall=wifi&&touchOk&&serviceOk;drawHeader("SYSTEM",overall?"HEALTHY":"CHECK",4);uiBottomNav(3,nullptr);String ip=wifi?WiFi.localIP().toString():String("No IP");
  if(hubLandscape()){
    HubRect device=hr(8,44,220,80),network=hr(236,44,236,80),access=hr(8,132,W-16,88);
    hubV1125Card(device,overall?W25_SUCCESS:W25_WARN,true);uiDrawFit("DEVICE",device.x+12,device.y+10,device.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE_2);uiDrawFit(overall?"HEALTHY":"CHECK DEVICE",device.x+12,device.y+38,device.w-24,FONT_LARGE,TL_DATUM,overall?W25_SUCCESS:W25_WARN,W25_SURFACE_2);
    hubV1125Card(network,wifi?W25_SUCCESS:W25_DANGER,false);uiDrawFit("NETWORK",network.x+12,network.y+10,network.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit(wifi?"CONNECTED":"OFFLINE",network.x+12,network.y+36,network.w-24,FONT_BODY,TL_DATUM,wifi?W25_SUCCESS:W25_DANGER,W25_SURFACE);uiDrawFit(wifi?ip.c_str():"Tap to review network settings",network.x+12,network.y+60,network.w-24,FONT_SMALL,BL_DATUM,W25_MUTED,W25_SURFACE);
    hubV1125Card(access,W25_ACCENT,false);uiDrawFit("LOCAL ACCESS",access.x+12,access.y+10,access.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit(securityPortalCode(),access.x+12,access.y+38,access.w-24,FONT_LARGE,TL_DATUM,W25_TEXT,W25_SURFACE);uiDrawFit("Portal code changes after every reboot",access.x+12,access.y+70,access.w-24,FONT_SMALL,BL_DATUM,W25_MUTED,W25_SURFACE);
    uiDrawFit("Advanced device details are in Portal > Diagnostics",10,252,W-20,FONT_SMALL,BL_DATUM,W25_MUTED,W25_BG);
  }else{
    HubRect device=hr(8,44,W-16,80),network=hr(8,132,W-16,80),access=hr(8,220,W-16,88);hubV1125Card(device,overall?W25_SUCCESS:W25_WARN,true);uiDrawFit("DEVICE",device.x+12,device.y+10,device.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE_2);uiDrawFit(overall?"HEALTHY":"CHECK DEVICE",device.x+12,device.y+38,device.w-24,FONT_LARGE,TL_DATUM,overall?W25_SUCCESS:W25_WARN,W25_SURFACE_2);hubV1125Card(network,wifi?W25_SUCCESS:W25_DANGER,false);uiDrawFit("NETWORK",network.x+12,network.y+10,network.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit(wifi?"CONNECTED":"OFFLINE",network.x+12,network.y+38,network.w-24,FONT_BODY,TL_DATUM,wifi?W25_SUCCESS:W25_DANGER,W25_SURFACE);hubV1125Card(access,W25_ACCENT,false);uiDrawFit("LOCAL ACCESS",access.x+12,access.y+10,access.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit(securityPortalCode(),access.x+12,access.y+40,access.w-24,FONT_BODY,TL_DATUM,W25_TEXT,W25_SURFACE);
  }
  hubMarkFrameDirty();g_dirty=false;
}
@@END_SYSTEM@@
