@@WORKSHOP@@
static void drawWorkshop(bool full) {
  (void)full;const int16_t W=tft.width();tft.fillScreen(W25_BG);drawHeader("WORKSHOP",nullptr,2);uiBottomNav(2,nullptr);
  const BambuState* s=isAnyPrinterConfigured()?&displayedPrinter().state:nullptr;
  if(hubLandscape()){
    HubRect timer=hr(8,48,304,86),note=hr(320,48,W-328,86),material=hr(8,142,W-16,58);
    const uint16_t tc=g_workshopTimerDone?W25_WARN:(workshopTimerActive()?W25_ACCENT:W25_LINE);hubV1125Card(timer,tc,true);uiDrawFit("TIMER",timer.x+14,timer.y+11,90,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE_2);char tv[28];workshopTimerText(tv,sizeof(tv));uiDrawFit(workshopTimerActive()||g_workshopTimerDone?tv:"READY",timer.x+14,timer.y+34,timer.w-28,FONT_LARGE,TL_DATUM,g_workshopTimerDone?W25_WARN:W25_TEXT,W25_SURFACE_2);uiDrawFit(workshopTimerActive()?"Running":(g_workshopTimerDone?"Done - tap Tools":"Choose a preset in Tools"),timer.x+14,timer.y+69,timer.w-28,FONT_SMALL,BL_DATUM,W25_MUTED,W25_SURFACE_2);
    hubV1125Card(note,W25_LINE,false);uiDrawFit("NOTE",note.x+12,note.y+11,note.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit(g_workshopNote[0]?g_workshopNote:"No note",note.x+12,note.y+37,note.w-24,FONT_BODY,TL_DATUM,g_workshopNote[0]?W25_TEXT:W25_MUTED,W25_SURFACE);
    hubV1125Card(material,W25_INFO,false);uiDrawFit("MATERIAL",material.x+12,material.y+9,82,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);char value[44]="Unknown / external";char detail[66]="Inventory: Unknown";if(s&&s->ams.present&&s->ams.activeTray<4&&s->ams.trays[s->ams.activeTray].present){const AmsTray&t=s->ams.trays[s->ams.activeTray];snprintf(value,sizeof(value),"A%u  %s",(unsigned)s->ams.activeTray+1,t.type[0]?t.type:"FILAMENT");if(t.remain>=0)snprintf(detail,sizeof(detail),"Printer telemetry  %d%%  |  inventory Unknown",(int)t.remain);else strlcpy(detail,"Printer telemetry  |  amount unknown",sizeof(detail));}uiDrawFit(value,material.x+102,material.y+9,150,FONT_BODY,TL_DATUM,W25_TEXT,W25_SURFACE);uiDrawFit(detail,material.x+12,material.y+36,material.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);
    char timerLab[18];workshopTimerText(timerLab,sizeof(timerLab),true);for(uint8_t i=0;i<4;i++){const char* lab=i==0?(s&&s->lightState==1?"LIGHT OFF":"LIGHT ON"):i==1?(g_workshopTimerDone?"TIMER DONE":(workshopTimerActive()?timerLab:"TOOLS")):i==2?"SYSTEM":"PRINTER";const bool enabled=i!=0||(s&&s->connected);hubV1125Action(hubWorkshopActionRect(i),lab,i==1&&g_workshopTimerDone?W25_WARN:(i==2?W25_INFO:W25_ACCENT),enabled,false);}
  }else{
    HubRect timer=hr(8,48,W-16,112),note=hr(8,168,W-16,80),material=hr(8,256,W-16,80);hubV1125Card(timer,workshopTimerActive()?W25_ACCENT:(g_workshopTimerDone?W25_WARN:W25_LINE),true);char tv[28];workshopTimerText(tv,sizeof(tv));uiDrawFit("TIMER",timer.x+14,timer.y+12,timer.w-28,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE_2);uiDrawFit(workshopTimerActive()||g_workshopTimerDone?tv:"READY",timer.x+14,timer.y+42,timer.w-28,FONT_LARGE,TL_DATUM,W25_TEXT,W25_SURFACE_2);hubV1125Card(note,W25_LINE,false);uiDrawFit("NOTE",note.x+12,note.y+12,note.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit(g_workshopNote[0]?g_workshopNote:"No note",note.x+12,note.y+41,note.w-24,FONT_BODY,TL_DATUM,g_workshopNote[0]?W25_TEXT:W25_MUTED,W25_SURFACE);hubV1125Card(material,W25_INFO,false);uiDrawFit("MATERIAL",material.x+12,material.y+12,material.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit("Inventory: Unknown",material.x+12,material.y+42,material.w-24,FONT_BODY,TL_DATUM,W25_TEXT,W25_SURFACE);for(uint8_t i=0;i<4;i++){const char* lab=i==0?(s&&s->lightState==1?"LIGHT OFF":"LIGHT ON"):i==1?"TOOLS":i==2?"SYSTEM":"PRINTER";hubV1125Action(hubWorkshopActionRect(i),lab,i==2?W25_INFO:W25_ACCENT,i!=0||(s&&s->connected),false);}
  }
  hubMarkFrameDirty();g_dirty=false;
}
@@END_WORKSHOP@@
