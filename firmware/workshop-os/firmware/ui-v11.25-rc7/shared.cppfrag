@@FINGERPRINT_HELPERS@@
static const char* hubV1125UiFingerprint(uint8_t page) {
  switch(page) {
    case 0: return "UI7-H";
    case 1: return "UI7-P";
    case 2: return "UI7-W";
    case 3: return "UI7-M";
    case 4: return "UI7-S";
    default: return "UI7";
  }
}
@@END_FINGERPRINT_HELPERS@@
@@CARD@@
static void hubV1125Card(const HubRect& r,uint16_t rail=UI_BORDER_2,bool strong=false) {
  const uint16_t bg=strong?W25_SURFACE_2:W25_SURFACE;
  tft.fillRoundRect(r.x,r.y,r.w,r.h,10,bg);
  tft.drawRoundRect(r.x,r.y,r.w,r.h,10,W25_LINE);
  if(rail!=UI_BORDER_2 && rail!=UI_BORDER && rail!=W25_LINE) {
    tft.fillRoundRect(r.x+1,r.y+12,4,r.h-24,2,rail);
  }
}
@@END_CARD@@
@@MODE_TABS@@
static void hubV1125ModeTabs() {
  static const char* labels[3]={"STATUS","AMS","CONTROL"};
  const int16_t W=tft.width();
  HubRect group=hr(8,46,W-16,52);
  tft.fillRoundRect(group.x,group.y,group.w,group.h,10,W25_NAV);
  tft.drawRoundRect(group.x,group.y,group.w,group.h,10,W25_LINE);
  for(uint8_t i=0;i<3;i++) {
    HubRect r=hubV1125PrinterModeRect(i);
    const bool selected=g_printerMode==i;
    if(selected) {
      tft.fillRoundRect(r.x+4,r.y+5,r.w-8,r.h-10,8,W25_SURFACE_3);
      tft.drawRoundRect(r.x+4,r.y+5,r.w-8,r.h-10,8,W25_ACCENT);
    }
    uiDrawFit(labels[i],r.x+r.w/2,r.y+r.h/2,r.w-20,FONT_BODY,MC_DATUM,selected?W25_TEXT:W25_MUTED,selected?W25_SURFACE_3:W25_NAV);
  }
}
@@END_MODE_TABS@@
@@ACTION@@
static void hubV1125Action(const HubRect& r,const char* label,uint16_t c,bool enabled=true,bool destructive=false) {
  const uint16_t edge=enabled?c:W25_LINE;
  const uint16_t bg=enabled?W25_SURFACE_2:W25_SURFACE;
  tft.fillRoundRect(r.x,r.y,r.w,r.h,10,bg);
  tft.drawRoundRect(r.x,r.y,r.w,r.h,10,edge);
  if(enabled)tft.fillRoundRect(r.x+1,r.y+11,4,r.h-22,2,edge);
  if(destructive&&enabled) {
    tft.fillCircle(r.x+r.w-15,r.y+15,4,W25_DANGER);
  }
  uiDrawFit(label,r.x+r.w/2,r.y+r.h/2,r.w-30,FONT_BODY,MC_DATUM,enabled?W25_TEXT:W25_MUTED,bg);
}
@@END_ACTION@@
@@TELEMETRY@@
static void hubV1125TelemetryColumn(const HubRect& r,const BambuState& s) {
  hubV1125Card(r,s.connected?W25_INFO:W25_LINE,false);
  uiDrawFit("TEMPERATURES",r.x+12,r.y+10,r.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);
  const char* labels[3]={"NOZZLE","BED","CHAMBER"};
  char vals[3][14];
  if(s.connected){
    snprintf(vals[0],sizeof(vals[0]),"%.0f C",s.nozzleTemp);
    snprintf(vals[1],sizeof(vals[1]),"%.0f C",s.bedTemp);
    snprintf(vals[2],sizeof(vals[2]),"%.0f C",s.chamberTemp);
  }else for(uint8_t i=0;i<3;i++)strlcpy(vals[i],"--",sizeof(vals[i]));
  const int16_t top=r.y+31,row=(r.h-36)/3;
  for(uint8_t i=0;i<3;i++){
    if(i)tft.drawFastHLine(r.x+12,top+i*row,r.w-24,W25_LINE);
    uiDrawFit(labels[i],r.x+12,top+i*row+row/2,r.w/2-16,FONT_SMALL,ML_DATUM,W25_MUTED,W25_SURFACE);
    uiDrawFit(vals[i],r.x+r.w-12,top+i*row+row/2,r.w/2-16,FONT_BODY,MR_DATUM,s.connected?W25_TEXT:W25_MUTED,W25_SURFACE);
  }
}
@@END_TELEMETRY@@
@@AMS_SLOT@@
static void hubV1125AmsSlot(const HubRect& r,const AmsTray* tr,bool active,uint8_t index) {
  const bool present=tr&&tr->present;
  const uint16_t bg=active?W25_SURFACE_2:W25_SURFACE;
  tft.fillRoundRect(r.x,r.y,r.w,r.h,10,bg);
  tft.drawRoundRect(r.x,r.y,r.w,r.h,10,active?W25_ACCENT:W25_LINE);
  if(active)tft.fillRoundRect(r.x+1,r.y+11,4,r.h-22,2,W25_ACCENT);
  char slot[8];snprintf(slot,sizeof(slot),"A%u",(unsigned)(index+1));
  char remain[12];if(present&&tr->remain>=0)snprintf(remain,sizeof(remain),"%d%%",(int)tr->remain);else strlcpy(remain,"--",sizeof(remain));
  uiDrawFit(slot,r.x+11,r.y+9,34,FONT_BODY,TL_DATUM,active?W25_ACCENT:W25_MUTED,bg);
  uiDrawFit(remain,r.x+r.w-11,r.y+9,42,FONT_BODY,TR_DATUM,present?W25_TEXT:W25_MUTED,bg);
  uint16_t filament=present?tr->colorRgb565:W25_LINE;if(present&&filament==0)filament=0x1082;
  uiSpoolScaled(r.x+r.w/2,r.y+48,filament,active,present?tr->remain:-1,13);
  uiDrawFit(present&&tr->type[0]?tr->type:"EMPTY",r.x+r.w/2,r.y+70,r.w-18,FONT_BODY,TC_DATUM,present?W25_TEXT:W25_MUTED,bg);
}
@@END_AMS_SLOT@@
@@HEADER@@
static void drawHeader(const char* title, const char* right, uint8_t page) {
  const int16_t W=tft.width(),HH=hubHeaderH();
  const bool online=WiFi.status()==WL_CONNECTED;
  tft.fillRect(0,0,W,HH,W25_BG);
  tft.fillRoundRect(8,8,26,26,8,W25_ACCENT);
  uiDrawFit("W",21,21,18,FONT_BODY,MC_DATUM,W25_BG,W25_ACCENT);
  uiDrawFit(title?title:"HOME",43,9,hubLandscape()?240:166,FONT_LARGE,TL_DATUM,W25_TEXT,W25_BG);
  const char* state=right&&right[0]?right:(online?"ONLINE":"OFFLINE");
  const uint16_t c=right&&right[0]?W25_INFO:(online?W25_SUCCESS:W25_DANGER);
  const int16_t pw=hubLandscape()?88:78;
  tft.fillRoundRect(W-pw-8,9,pw,24,12,W25_NAV);
  tft.fillCircle(W-pw+2,21,3,c);
  uiDrawFit(state,W-14,21,pw-24,FONT_SMALL,MR_DATUM,c,W25_NAV);
  // Keep the runtime renderer fingerprint available for automated capture without
  // spending visible header space on engineering metadata.
  (void)hubV1125UiFingerprint(page);
  tft.drawFastHLine(8,HH-1,W-16,W25_LINE);
}
@@END_HEADER@@
@@BOTTOM_NAV@@
static void uiBottomNav(uint8_t active, const char* nextPage) {
  (void)nextPage;
  const int16_t y=tft.height()-hubNavH(),W=tft.width();
  static const char* labels[4]={"HOME","PRINTER","WORKSHOP","MORE"};
  tft.fillRect(0,y,W,hubNavH(),W25_NAV);
  tft.drawFastHLine(0,y,W,W25_LINE);
  for(uint8_t i=0;i<4;i++){
    HubRect r=hubNavRect(i);const bool selected=i==active;
    if(selected){
      tft.fillRoundRect(r.x+5,r.y+5,r.w-10,r.h-10,9,W25_SURFACE_3);
      tft.drawRoundRect(r.x+5,r.y+5,r.w-10,r.h-10,9,W25_LINE);
      tft.fillRoundRect(r.x+r.w/2-18,r.y+4,36,3,2,W25_ACCENT);
    }
    uiDrawFit(labels[i],r.x+r.w/2,r.y+r.h/2+1,r.w-18,FONT_BODY,MC_DATUM,selected?W25_TEXT:W25_MUTED,selected?W25_SURFACE_3:W25_NAV);
  }
}
@@END_BOTTOM_NAV@@
