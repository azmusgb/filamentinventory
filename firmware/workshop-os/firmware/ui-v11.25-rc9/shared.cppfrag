@@FINGERPRINT_HELPERS@@
static const char* hubV1125UiFingerprint(uint8_t page) {
  switch(page) {
    case 0: return "UI9-H";
    case 1: return "UI9-P";
    case 2: return "UI9-W";
    case 3: return "UI9-M";
    case 4: return "UI9-S";
    default: return "UI9";
  }
}
@@END_FINGERPRINT_HELPERS@@
@@CARD@@
static void hubV1125Card(const HubRect& r,uint16_t rail=UI_BORDER_2,bool strong=false) {
  const uint16_t bg=strong?W25_SURFACE_2:W25_SURFACE;
  tft.fillRoundRect(r.x,r.y,r.w,r.h,14,bg);
  const bool semantic=rail!=UI_BORDER_2 && rail!=UI_BORDER && rail!=W25_LINE;
  if(semantic)tft.fillCircle(r.x+r.w-14,r.y+14,3,rail);
}
@@END_CARD@@
@@MODE_TABS@@
static void hubV1125ModeTabs() {
  static const char* labels[3]={"Status","AMS","Control"};
  const int16_t W=tft.width();
  HubRect group=hr(8,46,W-16,52);
  tft.fillRoundRect(group.x,group.y,group.w,group.h,14,W25_NAV);
  for(uint8_t i=0;i<3;i++) {
    HubRect r=hubV1125PrinterModeRect(i);
    const bool selected=g_printerMode==i;
    const uint16_t bg=selected?W25_SURFACE_3:W25_NAV;
    if(selected) {
      tft.fillRoundRect(r.x+4,r.y+5,r.w-8,r.h-10,11,bg);
      tft.fillRoundRect(r.x+r.w/2-16,r.y+r.h-8,32,3,2,W25_ACCENT);
    }
    uiDrawFit(labels[i],r.x+r.w/2,r.y+r.h/2-1,r.w-20,FONT_BODY,MC_DATUM,selected?W25_TEXT:W25_MUTED,bg);
  }
}
@@END_MODE_TABS@@
@@ACTION@@
static void hubV1125Action(const HubRect& r,const char* label,uint16_t c,bool enabled=true,bool destructive=false) {
  const uint16_t bg=enabled?W25_SURFACE_2:W25_SURFACE;
  const uint16_t text=!enabled?W25_MUTED:(destructive?W25_DANGER:W25_TEXT);
  tft.fillRoundRect(r.x,r.y,r.w,r.h,14,bg);
  if(enabled) {
    const uint16_t dot=destructive?W25_DANGER:c;
    tft.fillCircle(r.x+16,r.y+r.h/2,3,dot);
  }
  uiDrawFit(label,r.x+r.w/2+4,r.y+r.h/2,r.w-38,FONT_BODY,MC_DATUM,text,bg);
}
@@END_ACTION@@
@@TELEMETRY@@
static void hubV1125TelemetryColumn(const HubRect& r,const BambuState& s) {
  hubV1125Card(r,s.connected?W25_INFO:W25_LINE,false);
  uiDrawFit("Temperatures",r.x+14,r.y+11,r.w-28,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);
  const char* labels[3]={"Nozzle","Bed","Chamber"};
  char vals[3][14];
  if(s.connected){
    snprintf(vals[0],sizeof(vals[0]),"%.0f C",s.nozzleTemp);
    snprintf(vals[1],sizeof(vals[1]),"%.0f C",s.bedTemp);
    snprintf(vals[2],sizeof(vals[2]),"%.0f C",s.chamberTemp);
  }else for(uint8_t i=0;i<3;i++)strlcpy(vals[i],"--",sizeof(vals[i]));
  const int16_t top=r.y+31,row=(r.h-36)/3;
  for(uint8_t i=0;i<3;i++){
    if(i)tft.drawFastHLine(r.x+14,top+i*row,r.w-28,W25_LINE);
    uiDrawFit(labels[i],r.x+14,top+i*row+row/2,r.w/2-18,FONT_SMALL,ML_DATUM,W25_MUTED,W25_SURFACE);
    uiDrawFit(vals[i],r.x+r.w-14,top+i*row+row/2,r.w/2-18,FONT_BODY,MR_DATUM,s.connected?W25_TEXT:W25_MUTED,W25_SURFACE);
  }
}
@@END_TELEMETRY@@
@@AMS_SLOT@@
static void hubV1125AmsSlot(const HubRect& r,const AmsTray* tr,bool active,uint8_t index) {
  const bool present=tr&&tr->present;
  const uint16_t bg=active?W25_SURFACE_2:W25_SURFACE;
  tft.fillRoundRect(r.x,r.y,r.w,r.h,14,bg);
  if(active){
    tft.fillCircle(r.x+r.w-14,r.y+14,4,W25_ACCENT);
    tft.fillRoundRect(r.x+r.w/2-16,r.y+r.h-7,32,3,2,W25_ACCENT);
  }
  char slot[8];snprintf(slot,sizeof(slot),"A%u",(unsigned)(index+1));
  char remain[12];if(present&&tr->remain>=0)snprintf(remain,sizeof(remain),"%d%%",(int)tr->remain);else strlcpy(remain,"--",sizeof(remain));
  uiDrawFit(slot,r.x+12,r.y+10,34,FONT_BODY,TL_DATUM,active?W25_ACCENT:W25_MUTED,bg);
  uiDrawFit(remain,r.x+r.w-12,r.y+10,42,FONT_BODY,TR_DATUM,present?W25_TEXT:W25_MUTED,bg);
  uint16_t filament=present?tr->colorRgb565:W25_LINE;if(present&&filament==0)filament=0x1082;
  uiSpoolScaled(r.x+r.w/2,r.y+49,filament,active,present?tr->remain:-1,13);
  uiDrawFit(present&&tr->type[0]?tr->type:"Empty",r.x+r.w/2,r.y+72,r.w-18,FONT_BODY,TC_DATUM,present?W25_TEXT:W25_MUTED,bg);
}
@@END_AMS_SLOT@@
@@HEADER@@
static void drawHeader(const char* title, const char* right, uint8_t page) {
  const int16_t W=tft.width(),HH=hubHeaderH();
  const bool online=WiFi.status()==WL_CONNECTED;
  tft.fillRect(0,0,W,HH,W25_BG);
  uiDrawFit(title?title:"Home",12,8,hubLandscape()?270:178,FONT_BODY,TL_DATUM,W25_TEXT,W25_BG);
  const char* state=right&&right[0]?right:(online?"Online":"Offline");
  const uint16_t c=right&&right[0]?W25_INFO:(online?W25_SUCCESS:W25_DANGER);
  const int16_t pw=hubLandscape()?104:90;
  tft.fillCircle(W-pw+4,18,3,c);
  uiDrawFit(state,W-12,18,pw-18,FONT_SMALL,MR_DATUM,c,W25_BG);
  (void)hubV1125UiFingerprint(page);
}
@@END_HEADER@@
@@BOTTOM_NAV@@
static void uiBottomNav(uint8_t active, const char* nextPage) {
  (void)nextPage;
  const int16_t y=tft.height()-hubNavH(),W=tft.width();
  static const char* labels[4]={"Home","Printer","Workshop","Settings"};
  tft.fillRect(0,y,W,hubNavH(),W25_NAV);
  tft.drawFastHLine(0,y,W,W25_LINE);
  for(uint8_t i=0;i<4;i++){
    HubRect r=hubNavRect(i);const bool selected=i==active;
    const uint16_t bg=selected?W25_SURFACE_3:W25_NAV;
    if(selected){
      tft.fillRoundRect(r.x+5,r.y+5,r.w-10,r.h-10,14,bg);
      tft.fillRoundRect(r.x+r.w/2-16,r.y+5,32,3,2,W25_ACCENT);
    }
    uiDrawFit(labels[i],r.x+r.w/2,r.y+r.h/2+2,r.w-16,FONT_BODY,MC_DATUM,selected?W25_TEXT:W25_MUTED,bg);
  }
}
@@END_BOTTOM_NAV@@
