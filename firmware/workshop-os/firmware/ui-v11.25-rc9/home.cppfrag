@@HOME@@
static void drawHome(bool full) {
  (void)full;
  const int16_t W=tft.width();
  const bool configured=isAnyPrinterConfigured();
  const PrinterSlot* p=configured?&displayedPrinter():nullptr;
  const BambuState* s=p?&p->state:nullptr;
  if(g_ambientEnabled&&g_ambientActive){drawAmbientHome(p,s);return;}
  tft.fillScreen(W25_BG);drawHeader("Home",nullptr,0);uiBottomNav(0,nullptr);
  const uint16_t sc=hubV1125PrinterColor(s);
  const bool paused=s&&s->gcodeStateId==GCODE_PAUSE;
  const bool printing=s&&s->printing;
  const bool online=s&&s->connected;
  const bool wifi=WiFi.status()==WL_CONNECTED;
  const char* state=!configured?"No printer":(!online?"Printer offline":(paused?"Paused":(printing?"Printing":"Ready")));

  if(hubLandscape()){
    HubRect hero=hr(8,44,312,146),material=hr(8,198,152,62),network=hr(168,198,152,62),status=hr(328,44,W-336,216);
    hubV1125Card(hero,sc,true);
    uiDrawFit(p&&p->config.name[0]?p->config.name:"Printer",hero.x+16,hero.y+12,hero.w-32,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE_2);
    uiDrawFit(state,hero.x+16,hero.y+36,hero.w-32,FONT_LARGE,TL_DATUM,sc,W25_SURFACE_2);
    if(printing||paused){
      uiDrawFit(jobDisplayName(*s),hero.x+16,hero.y+74,hero.w-32,FONT_BODY,TL_DATUM,W25_TEXT,W25_SURFACE_2);
      uiProgressBar(hero.x+16,hero.y+106,hero.w-32,s->progress,W25_ACCENT);
      char rem[20],meta[42];formatDuration(s->remainingMinutes,rem,sizeof(rem));snprintf(meta,sizeof(meta),"%u%%   %s left",(unsigned)s->progress,rem);
      uiDrawFit(meta,hero.x+16,hero.y+127,hero.w-32,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE_2);
    }else{
      const char* explain=!configured?"Connect a printer to begin":(!online?"Check the printer connection":"Ready for the next print");
      uiDrawFit(explain,hero.x+16,hero.y+84,hero.w-32,FONT_BODY,TL_DATUM,W25_TEXT_2,W25_SURFACE_2);
    }

    hubV1125Card(material,W25_INFO,false);
    uiDrawFit("Printer material",material.x+12,material.y+10,material.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);
    char mv[28]="Unknown";
    if(s&&s->ams.present&&s->ams.activeTray<4&&s->ams.trays[s->ams.activeTray].present){const AmsTray&t=s->ams.trays[s->ams.activeTray];snprintf(mv,sizeof(mv),"A%u  %s",(unsigned)s->ams.activeTray+1,t.type[0]?t.type:"Filament");}
    uiDrawFit(mv,material.x+12,material.y+37,material.w-24,FONT_BODY,TL_DATUM,(s&&s->ams.present)?W25_TEXT:W25_MUTED,W25_SURFACE);

    hubV1125Card(network,wifi?W25_SUCCESS:W25_DANGER,false);
    uiDrawFit("Network",network.x+12,network.y+10,network.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);
    uiDrawFit(wifi?"Connected":"Offline",network.x+12,network.y+37,network.w-24,FONT_BODY,TL_DATUM,wifi?W25_TEXT:W25_DANGER,W25_SURFACE);

    uint16_t nc=W25_SUCCESS;const char* nt="All clear";char nd[44]="Nothing needs attention";
    if(g_workshopTimerDone){nc=W25_WARN;nt="Timer done";strlcpy(nd,"Open Workshop to clear it",sizeof(nd));}
    else if(s&&uiHmsCount(*s)){nc=W25_WARN;nt="Printer alert";snprintf(nd,sizeof(nd),"%u alert%s to review",(unsigned)uiHmsCount(*s),uiHmsCount(*s)==1?"":"s");}
    else if(configured&&s&&!s->connected){nc=W25_WARN;nt="Printer offline";strlcpy(nd,"Open Printer to reconnect",sizeof(nd));}
    else if(!wifi){nc=W25_DANGER;nt="Network offline";strlcpy(nd,"Open Settings to reconnect",sizeof(nd));}
    else if(workshopTimerActive()){nc=W25_ACCENT;nt="Timer running";workshopTimerText(nd,sizeof(nd));}
    hubV1125Card(status,nc,false);
    uiDrawFit("Attention",status.x+14,status.y+14,status.w-28,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);
    uiDrawFit(nt,status.x+14,status.y+48,status.w-28,FONT_BODY,TL_DATUM,nc,W25_SURFACE);
    uiDrawFit(nd,status.x+14,status.y+88,status.w-28,FONT_SMALL,TL_DATUM,W25_TEXT_2,W25_SURFACE);
  }else{
    HubRect hero=hr(8,44,W-16,150),material=hr(8,202,W-16,64),network=hr(8,274,W-16,64),attention=hr(8,346,W-16,86);
    hubV1125Card(hero,sc,true);uiDrawFit(p&&p->config.name[0]?p->config.name:"Printer",hero.x+14,hero.y+12,hero.w-28,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE_2);uiDrawFit(state,hero.x+14,hero.y+40,hero.w-28,FONT_LARGE,TL_DATUM,sc,W25_SURFACE_2);if(printing||paused){uiDrawFit(jobDisplayName(*s),hero.x+14,hero.y+84,hero.w-28,FONT_BODY,TL_DATUM,W25_TEXT,W25_SURFACE_2);uiProgressBar(hero.x+14,hero.y+124,hero.w-28,s->progress,W25_ACCENT);}else{uiDrawFit(!configured?"Connect a printer to begin":(online?"Ready for the next print":"Check the printer connection"),hero.x+14,hero.y+88,hero.w-28,FONT_BODY,TL_DATUM,W25_MUTED,W25_SURFACE_2);}
    hubV1125Card(material,W25_INFO,false);uiDrawFit("Printer material",material.x+12,material.y+10,material.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit(s&&s->ams.present?"AMS connected":"Unknown",material.x+12,material.y+38,material.w-24,FONT_BODY,TL_DATUM,s&&s->ams.present?W25_TEXT:W25_MUTED,W25_SURFACE);
    hubV1125Card(network,wifi?W25_SUCCESS:W25_DANGER,false);uiDrawFit("Network",network.x+12,network.y+10,network.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit(wifi?"Connected":"Offline",network.x+12,network.y+38,network.w-24,FONT_BODY,TL_DATUM,wifi?W25_TEXT:W25_DANGER,W25_SURFACE);
    hubV1125Card(attention,W25_LINE,false);uiDrawFit("Attention",attention.x+12,attention.y+12,attention.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit(g_workshopTimerDone?"Timer done":"All clear",attention.x+12,attention.y+44,attention.w-24,FONT_BODY,TL_DATUM,g_workshopTimerDone?W25_WARN:W25_SUCCESS,W25_SURFACE);
  }
  hubMarkFrameDirty();g_dirty=false;
}
@@END_HOME@@
