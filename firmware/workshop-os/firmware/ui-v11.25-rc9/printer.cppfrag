@@PRINTER@@
static void drawPrinter(bool full) {
  (void)full;const int16_t W=tft.width();tft.fillScreen(W25_BG);drawHeader("Printer",nullptr,1);uiBottomNav(1,nullptr);hubV1125ModeTabs();
  if(!isAnyPrinterConfigured()){
    HubRect r=hubLandscape()?hr(8,104,W-16,156):hr(8,104,W-16,306);hubV1125Card(r,W25_ACCENT,true);
    uiDrawFit("No printer",r.x+16,r.y+28,r.w-32,FONT_LARGE,TL_DATUM,W25_TEXT,W25_SURFACE_2);
    uiDrawFit("Connect a printer to begin.",r.x+16,r.y+72,r.w-32,FONT_BODY,TL_DATUM,W25_TEXT_2,W25_SURFACE_2);
    uiDrawFit("Use the local portal to add LAN or Cloud access.",r.x+16,r.y+102,r.w-32,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE_2);
    uiDrawFit("Open Local Portal",r.x+16,r.y+r.h-24,r.w-32,FONT_BODY,BL_DATUM,W25_ACCENT,W25_SURFACE_2);
    hubMarkFrameDirty();g_dirty=false;return;
  }
  const PrinterSlot&p=displayedPrinter();const BambuState&s=p.state;const uint16_t sc=hubV1125PrinterColor(&s);const bool paused=s.gcodeStateId==GCODE_PAUSE;const bool active=s.printing||paused;const char* state=!s.connected?"Offline":(paused?"Paused":(s.printing?"Printing":"Ready"));
  if(g_printerMode==HUB_PRINTER_STATUS){
    if(hubLandscape()){
      HubRect job=hr(8,104,300,156),live=hr(316,104,W-324,156);hubV1125Card(job,sc,true);
      uiDrawFit(p.config.name[0]?p.config.name:"Printer",job.x+16,job.y+12,job.w-32,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE_2);uiDrawFit(state,job.x+16,job.y+36,job.w-32,FONT_LARGE,TL_DATUM,sc,W25_SURFACE_2);
      if(active){char rem[20],meta[42];formatDuration(s.remainingMinutes,rem,sizeof(rem));snprintf(meta,sizeof(meta),"%u%%   %s left",(unsigned)s.progress,rem);uiDrawFit(jobDisplayName(s),job.x+16,job.y+75,job.w-32,FONT_BODY,TL_DATUM,W25_TEXT,W25_SURFACE_2);uiProgressBar(job.x+16,job.y+107,job.w-32,s.progress,W25_ACCENT);uiDrawFit(meta,job.x+16,job.y+128,job.w-32,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE_2);}else{uiDrawFit(s.connected?"Ready for the next print":"Connection lost",job.x+16,job.y+84,job.w-32,FONT_BODY,TL_DATUM,s.connected?W25_TEXT_2:W25_WARN,W25_SURFACE_2);uiDrawFit(s.connected?"":"Check LAN or Cloud settings",job.x+16,job.y+120,job.w-32,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE_2);}
      hubV1125TelemetryColumn(live,s);
    }else{
      HubRect job=hr(8,104,W-16,154),live=hr(8,266,W-16,144);hubV1125Card(job,sc,true);uiDrawFit(p.config.name[0]?p.config.name:"Printer",job.x+14,job.y+12,job.w-28,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE_2);uiDrawFit(state,job.x+14,job.y+38,job.w-28,FONT_LARGE,TL_DATUM,sc,W25_SURFACE_2);if(active){uiDrawFit(jobDisplayName(s),job.x+14,job.y+82,job.w-28,FONT_BODY,TL_DATUM,W25_TEXT,W25_SURFACE_2);uiProgressBar(job.x+14,job.y+122,job.w-28,s.progress,W25_ACCENT);}else uiDrawFit(s.connected?"Ready for the next print":"Check the printer connection",job.x+14,job.y+86,job.w-28,FONT_BODY,TL_DATUM,W25_MUTED,W25_SURFACE_2);hubV1125TelemetryColumn(live,s);
    }
  }else if(g_printerMode==HUB_PRINTER_AMS){
    if(hubLandscape()){
      const int16_t g=6,m=8,cw=(W-2*m-3*g)/4;uint8_t n=s.ams.present?s.ams.unitCount*4:0;if(n>4)n=4;for(uint8_t i=0;i<4;i++){HubRect r=hr(m+i*(cw+g),104,cw,122);hubV1125AmsSlot(r,(i<n)?&s.ams.trays[i]:nullptr,s.ams.present&&s.ams.activeTray==i,i);}
      uiDrawFit(s.ams.present?"Printer telemetry - inventory spool identity may be Unknown":"No AMS - connect AMS or use an external spool",10,249,W-20,FONT_SMALL,BL_DATUM,s.ams.present?W25_MUTED:W25_WARN,W25_BG);
    }else{
      uint8_t n=s.ams.present?s.ams.unitCount*4:0;if(n>4)n=4;const int16_t g=8,m=8,cw=(W-2*m-g)/2,ch=110;for(uint8_t i=0;i<4;i++){HubRect r=hr(m+(i%2)*(cw+g),104+(i/2)*(ch+g),cw,ch);hubV1125AmsSlot(r,(i<n)?&s.ams.trays[i]:nullptr,s.ams.present&&s.ams.activeTray==i,i);}
    }
  }else{
    const char* light=s.lightState==1?"Light Off":"Light On";const char* pause=paused?"Resume":"Pause";const uint8_t plug=tasmotaControlPlugForSlot(rotState.displayIndex);const bool powerMapped=plug!=0xFF;
    for(uint8_t i=0;i<4;i++){HubRect r=hubPrinterActionRect(i);const char* label=i==0?printerFeedbackLabel(0,light):i==1?printerFeedbackLabel(1,pause):i==2?(powerMapped?"Printer Power":"Power unavailable"):printerFeedbackLabel(3,active?"Hold to Stop":"Stop");const bool enabled=i==0?s.connected:i==1?(s.connected&&active):i==2?powerMapped:(s.connected&&active);const uint16_t c=i==0?W25_INFO:i==1?(paused?W25_SUCCESS:W25_ACCENT):i==2?W25_WARN:W25_DANGER;hubV1125Action(r,label,c,enabled,i==3);}
    if(hubLandscape())uiDrawFit(active?"Hold Stop until the progress indicator completes":"Controls ready",10,250,W-20,FONT_SMALL,BL_DATUM,active?W25_MUTED:W25_MUTED,W25_BG);
  }
  hubMarkFrameDirty();g_dirty=false;
}
@@END_PRINTER@@
