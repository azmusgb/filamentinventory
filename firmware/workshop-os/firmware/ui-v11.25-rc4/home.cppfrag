@@HOME@@
static void drawHome(bool full) {
  (void)full;
  const int16_t W=tft.width();
  const bool configured=isAnyPrinterConfigured();
  const PrinterSlot* p=configured?&displayedPrinter():nullptr;
  const BambuState* s=p?&p->state:nullptr;
  if(g_ambientEnabled&&g_ambientActive){drawAmbientHome(p,s);return;}
  tft.fillScreen(W25_BG);drawHeader("HOME",nullptr,0);uiBottomNav(0,nullptr);
  const uint16_t sc=hubV1125PrinterColor(s);

  if(hubLandscape()){
    HubRect hero=hr(8,48,304,128),material=hr(8,184,148,76),network=hr(164,184,148,76),rail=hr(320,48,W-328,212);
    hubV1125Card(hero,sc,true);
    uiDrawFit("PRINTER",hero.x+14,hero.y+12,90,FONT_SMALL,TL_DATUM,sc,W25_SURFACE_2);
    uiDrawFit(hubV1125PrinterTitle(s),hero.x+14,hero.y+34,hero.w-28,FONT_LARGE,TL_DATUM,W25_TEXT,W25_SURFACE_2);
    uiDrawFit(p&&p->config.name[0]?p->config.name:(p?"Bambu printer":"No printer configured"),hero.x+14,hero.y+72,hero.w-28,FONT_BODY,TL_DATUM,W25_TEXT_2,W25_SURFACE_2);
    if(s&&s->printing){
      char meta[60];char rem[20];formatDuration(s->remainingMinutes,rem,sizeof(rem));snprintf(meta,sizeof(meta),"%u%%  |  %s left  |  L%u/%u",(unsigned)s->progress,rem,(unsigned)s->layerNum,(unsigned)s->totalLayers);
      uiProgressBar(hero.x+14,hero.y+99,hero.w-28,s->progress,W25_ACCENT);
      uiDrawFit(meta,hero.x+14,hero.y+116,hero.w-28,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE_2);
    }else{
      uiDrawFit(s&&s->connected?"Ready for next job":"Telemetry unavailable",hero.x+14,hero.y+104,hero.w-28,FONT_BODY,TL_DATUM,s&&s->connected?W25_SUCCESS:W25_WARN,W25_SURFACE_2);
    }

    char mv[32]="Unknown";char md[40]="Inventory identity Unknown";
    if(s&&s->ams.present&&s->ams.activeTray<4&&s->ams.trays[s->ams.activeTray].present){const AmsTray&t=s->ams.trays[s->ams.activeTray];snprintf(mv,sizeof(mv),"A%u  %s",(unsigned)s->ams.activeTray+1,t.type[0]?t.type:"FILAMENT");strlcpy(md,"Printer telemetry",sizeof(md));}
    hubV1125Card(material,W25_INFO,false);uiDrawFit("MATERIAL",material.x+12,material.y+10,material.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit(mv,material.x+12,material.y+32,material.w-24,FONT_BODY,TL_DATUM,W25_TEXT,W25_SURFACE);uiDrawFit(md,material.x+12,material.y+56,material.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);

    const bool wifi=WiFi.status()==WL_CONNECTED;hubV1125Card(network,wifi?W25_SUCCESS:W25_DANGER,false);uiDrawFit("NETWORK",network.x+12,network.y+10,network.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit(wifi?"ONLINE":"OFFLINE",network.x+12,network.y+32,network.w-24,FONT_BODY,TL_DATUM,wifi?W25_SUCCESS:W25_DANGER,W25_SURFACE);uiDrawFit(wifi?"Local control ready":"Check Wi-Fi",network.x+12,network.y+56,network.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);

    hubV1125Card(rail,W25_LINE,false);
    uiDrawFit("WORKSHOP STATUS",rail.x+12,rail.y+12,rail.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);
    uint16_t nc=W25_SUCCESS;const char* nt="ALL CLEAR";char nd[40]="Nothing needs attention";
    if(g_workshopTimerDone){nc=W25_WARN;nt="TIMER DONE";strlcpy(nd,"Open Workshop",sizeof(nd));}
    else if(s&&uiHmsCount(*s)){nc=W25_WARN;nt="ATTENTION";snprintf(nd,sizeof(nd),"%u printer alert%s",(unsigned)uiHmsCount(*s),uiHmsCount(*s)==1?"":"s");}
    else if(s&&!s->connected){nc=W25_WARN;nt="CHECK PRINTER";strlcpy(nd,"Connection unavailable",sizeof(nd));}
    else if(!wifi){nc=W25_DANGER;nt="NETWORK";strlcpy(nd,"Wi-Fi unavailable",sizeof(nd));}
    else if(workshopTimerActive()){nc=W25_ACCENT;nt="TIMER ACTIVE";workshopTimerText(nd,sizeof(nd));}
    tft.fillRoundRect(rail.x+12,rail.y+38,rail.w-24,58,7,W25_SURFACE_2);tft.drawRoundRect(rail.x+12,rail.y+38,rail.w-24,58,7,nc);
    uiDrawFit(nt,rail.x+22,rail.y+51,rail.w-44,FONT_BODY,TL_DATUM,nc,W25_SURFACE_2);uiDrawFit(nd,rail.x+22,rail.y+76,rail.w-44,FONT_SMALL,TL_DATUM,W25_TEXT_2,W25_SURFACE_2);
    tft.drawFastHLine(rail.x+12,rail.y+111,rail.w-24,W25_LINE);
    uiDrawFit("ACCESS",rail.x+12,rail.y+124,rail.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit("NO CODE",rail.x+12,rail.y+146,rail.w-24,FONT_BODY,TL_DATUM,W25_WARN,W25_SURFACE);uiDrawFit("TEST BUILD ONLY",rail.x+12,rail.y+169,rail.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);
    char ver[22];snprintf(ver,sizeof(ver),"%s RC4",SMART_HOME_VERSION);uiDrawFit(ver,rail.x+12,rail.y+194,rail.w-24,FONT_SMALL,BL_DATUM,W25_ACCENT,W25_SURFACE);
  }else{
    HubRect hero=hr(8,48,W-16,150),material=hr(8,206,W-16,72),network=hr(8,286,W-16,64),access=hr(8,358,W-16,62);
    hubV1125Card(hero,sc,true);uiDrawFit("PRINTER",hero.x+14,hero.y+12,90,FONT_SMALL,TL_DATUM,sc,W25_SURFACE_2);uiDrawFit(hubV1125PrinterTitle(s),hero.x+14,hero.y+38,hero.w-28,FONT_LARGE,TL_DATUM,W25_TEXT,W25_SURFACE_2);uiDrawFit(p&&p->config.name[0]?p->config.name:(p?"Bambu printer":"No printer configured"),hero.x+14,hero.y+82,hero.w-28,FONT_BODY,TL_DATUM,W25_TEXT_2,W25_SURFACE_2);if(s&&s->printing)uiProgressBar(hero.x+14,hero.y+122,hero.w-28,s->progress,W25_ACCENT);
    hubV1125Card(material,W25_INFO,false);uiDrawFit("MATERIAL",material.x+12,material.y+11,material.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit(s&&s->ams.present?"AMS telemetry available":"External / unreported",material.x+12,material.y+38,material.w-24,FONT_BODY,TL_DATUM,W25_TEXT,W25_SURFACE);
    const bool wifi=WiFi.status()==WL_CONNECTED;hubV1125Card(network,wifi?W25_SUCCESS:W25_DANGER,false);uiDrawFit("NETWORK",network.x+12,network.y+9,material.w-24,FONT_SMALL,TL_DATUM,W25_MUTED,W25_SURFACE);uiDrawFit(wifi?"ONLINE":"OFFLINE",network.x+12,network.y+34,network.w-24,FONT_BODY,TL_DATUM,wifi?W25_SUCCESS:W25_DANGER,W25_SURFACE);
    hubV1125Card(access,W25_WARN,false);uiDrawFit("ACCESS  /  NO CODE  /  TEST BUILD ONLY",access.x+12,access.y+31,access.w-24,FONT_SMALL,ML_DATUM,W25_WARN,W25_SURFACE);
  }
  hubMarkFrameDirty();g_dirty=false;
}
@@END_HOME@@
