{
  "settings": [
    {
      "id": "alerts.hms",
      "classification": "PHYSICAL",
      "implementedOnDevice": true,
      "surface": "Display → Alerts / Signals",
      "browserBindings": [
        {
          "route": "/apply",
          "keys": ["hmsauto", "hmsen", "hmssev", "hmsonl", "hmsmask"]
        },
        {
          "route": "/save/toggle",
          "keys": ["hmsauto", "hmsen", "hmssev", "hmsonl", "hmsmask"]
        }
      ],
      "physicalEvidence": ["\"ALERTS\"", "\"SIGNALS\"", "hmsEnabled", "hmsSeverityAll"]
    },
    {
