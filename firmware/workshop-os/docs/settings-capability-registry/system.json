      "surface": "System → Network Expert → Time & Locale",
      "browserBindings": [
        {"route": "/apply", "keys": ["tz"]}
      ],
      "physicalEvidence": ["\"TIMEZONE\"", "hubStepTimezone", "configTzTime(netSettings.timezoneStr"]
    },
    {
      "id": "network.show-ip",
      "classification": "PHYSICAL",
