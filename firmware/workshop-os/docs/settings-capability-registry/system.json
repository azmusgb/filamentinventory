      "browserBindings": [
        {"route": "/save/toggle", "keys": ["showip"]},
        {"route": "/save/wifi", "keys": ["showip"]}
      ],
      "physicalEvidence": ["showIPAtStartup"]
    },
    {
      "id": "network.mdns",
      "classification": "PHYSICAL",
      "implementedOnDevice": true,
      "surface": "System → Network Essentials",
      "browserBindings": [
        {"route": "/save/wifi", "keys": ["mdns_en"]}
      ],
      "physicalEvidence": ["mdnsEnabled"]
    },
    {
      "id": "network.static-address",
      "classification": "PHYSICAL-EXPERT",
